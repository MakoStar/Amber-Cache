    "Type": 4,
    "SkinId": 0,
    "VoResource": "vo_149_ui_unlockCG_001",
    "Lines": "呵呵~握住别人的灵魂，感觉如何？"
  },
  "14905": {
    "Id": 14905,
    "Character": 149,
    "Type": 5,
    "SkinId": 14903,
    "VoResource": "",
    "Lines": "咖啡的酸涩，蔷薇的芳香，想将一切新奇的体验都与你分享。融雪后，来一场约会吧？"
