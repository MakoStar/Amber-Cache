    "Type": 5,
    "SkinId": 12604,
    "VoResource": "",
    "Lines": "???"
  },
  "12701": {
    "Id": 12701,
    "Character": 127,
    "Type": 1,
    "SkinId": 0,
    "VoResource": "vo_127_ui_gachaNew_001",
    "Lines": "喔~又发现一条新航道！\n哼哼~我是万送屋的特丽莎，想寄信时，您和我说一声就行。"
  },
  "12702": {
    "Id": 12702,
    "Character": 127,
    "Type": 2,
    "SkinId": 0,
    "VoResource": "vo_127_ui_gacha_001",
    "Lines": "又见面了，魔王，万送屋的服务您还满意吗？"
  },
  "12703": {
    "Id": 12703,
    "Character": 127,
    "Type": 3,
    "SkinId": 0,
    "VoResource": "vo_127_ui_unlockLook_001",
    "Lines": "现在的我，说不定连传说中的龙也能打倒呢！"
  },
  "12704": {
    "Id": 12704,
    "Character": 127,
    "Type": 4,
    "SkinId": 0,
    "VoResource": "vo_127_ui_unlockCG_001",
    "Lines": "真是的……好像什么都瞒不住你呢……"
  },
  "12705": {
    "Id": 12705,
    "Character": 127,
    "Type": 5,
    "SkinId": 12703,
    "VoResource": "",
    "Lines": "拿起村里最好的宝剑，踏上勇者特丽莎的传奇冒险！欸~金光闪闪的宝箱？让我打开看看——呜哇——这是什么东西？！"
  },
  "12706": {
    "Id": 12706,
    "Character": 127,
    "Type": 5,
    "SkinId": 12704,
    "VoResource": "",
    "Lines": "???"
  },
  "13001": {
    "Id": 13001,
    "Character": 130,
    "Type": 1,
    "SkinId": 0,
    "VoResource": "vo_130_ui_gachaNew_001",
    "Lines": "初次见面，万送屋为您服务。\n无论是雪山还是雨林，\n你邮我寄，让信件平安传递！"
  },
  "13002": {
    "Id": 13002,
    "Character": 130,
    "Type": 2,
    "SkinId": 0,
    "VoResource": "vo_130_ui_gacha_001",
    "Lines": "诶？又见面了？\n啊哈哈，我才没有迷路！我是故意跟着你的。"
  },
  "13003": {
    "Id": 13003,
    "Character": 130,
    "Type": 3,
    "SkinId": 0,
    "VoResource": "vo_130_ui_unlockLook_001",
    "Lines": "哇呜，我是不是变得更可爱了？"
  },
  "13004": {
    "Id": 13004,
    "Character": 130,
    "Type": 4,
    "SkinId": 0,
    "VoResource": "vo_130_ui_unlockCG_001",
    "Lines": "多娜~可爱变身！"
  },
  "13005": {
    "Id": 13005,
    "Character": 130,
    "Type": 5,
    "SkinId": 13003,
    "VoResource": "",
    "Lines": "???"
